# Copy this file to ".env". Leave USE_BEDROCK=false to run with the mock LLM.
USE_BEDROCK=false
AWS_REGION=us-east-1
# Any Bedrock model you have access to (enable it in AWS console: Bedrock -> Model access)
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
# Credentials: run `aws configure` once, or set these:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
